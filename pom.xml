<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.clafer</groupId>
    <artifactId>chocosolver-parent</artifactId>
    <version>0.6.0</version>
    <packaging>pom</packaging>

    <name>chocosolver-parent</name>
    <url>http://github.com/gsdlab/chocosolver</url>
    <description>The Clafer frontend for the explicit languages, and chocosolver, the Choco 6 backend for Clafer.</description>

    <modules>
        <module>frontend</module>
        <module>solver</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <!-- the number of JVMs that run the test classes; e.g., -Dtest.forks=1 runs them one by one -->
        <test.forks>1C</test.forks>
        <!-- the Clafer checkout whose regressions the tests read -->
        <clafer.dir>${maven.multiModuleProjectDirectory}/../clafer</clafer.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <!-- the test classes run in parallel, in one JVM per core, each class in one JVM -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.0</version>
                    <configuration>
                        <forkCount>${test.forks}</forkCount>
                        <reuseForks>true</reuseForks>
                        <systemPropertyVariables>
                            <clafer.dir>${clafer.dir}</clafer.dir>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
